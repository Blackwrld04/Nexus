# ==============================================================================
# NEXUS ENVIRONMENT CONFIGURATION (.env.example)
# Never commit real private keys or secrets to public repositories.
# ==============================================================================

# Monad Testnet RPC Endpoints (Multi-Tier Redundancy: Dwellir, QuickNode, Spectrum)
DWELLIR_API_KEY=your_dwellir_api_key_here
MONAD_RPC_URL=https://api-monad-testnet-full.n.dwellir.com/your_dwellir_api_key_here
MONAD_WSS_URL=wss://api-monad-testnet-full.n.dwellir.com/your_dwellir_api_key_here

# QuickNode Dedicated Monad Testnet RPC
QUICKNODE_RPC_URL=https://solemn-nameless-meme.monad-testnet.quiknode.pro/your_quicknode_token_here/
QUICKNODE_WSS_URL=wss://solemn-nameless-meme.monad-testnet.quiknode.pro/your_quicknode_token_here/

# Public Fallback Endpoints
MONAD_RPC_FALLBACK_URL=https://testnet-rpc.monad.xyz
MONAD_RPC_INFRA_URL=https://rpc-testnet.monadinfra.com
MONAD_CHAIN_ID=10143

# Spectrum Nodes (Simply Staking) High-Throughput Unified Indexer API (200 RPS)
SPECTRUM_API_URL=https://spectrum-03.simplystaking.xyz/cnl1dGtmemktMzU3NjE4MWI/Jdmon1zt2SHWxQ/spectrumapi/v1

# Deployer / Operator Private Key (Hex without 0x prefix or with 0x)
PRIVATE_KEY=your_monad_testnet_private_key_here

# Deployed Contract Addresses on Monad Testnet
NEXT_PUBLIC_IDENTITY_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_REPUTATION_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_AUSD_ADDRESS=0x00000000eFE302BEAA2b3e6e1b18d08D69a9012a # Official Agora AUSD on Monad
NEXT_PUBLIC_ESCROW_VAULT_ADDRESS=0x0000000000000000000000000000000000000000

# Agora Institutional Stablecoin
AGORA_AUSD_ADDRESS=0x00000000eFE302BEAA2b3e6e1b18d08D69a9012a

# Third-Party Sponsor API Keys (Fallback SAMPLE_MODE=true is built in)
SAMPLE_MODE=true
NANSEN_API_KEY=your_nansen_api_key_here
PRIVY_APP_ID=your_privy_app_id_here
GROQ_API_KEY=your_groq_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_or_groq_key_here
